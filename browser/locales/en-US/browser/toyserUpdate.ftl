## Toyser "new version available" bar.

# Variables:
#   $version (String) - The new version, e.g. "1.2.0".
toyser-update-available = O { -brand-short-name } { $version } está disponível.
toyser-update-button = Atualizar agora
toyser-update-later = Depois
toyser-update-skip = Pular esta versão

## Toyser "Check for updates" item in the app menu.

toyser-update-check-menu =
    .label = Verificar atualizações…
# Variables:
#   $version (String) - The installed version, e.g. "1.3.0".
toyser-update-up-to-date = O { -brand-short-name } { $version } está atualizado.
toyser-update-check-failed = Não foi possível verificar atualizações. Confira sua conexão e tente de novo.
